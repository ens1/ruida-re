{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruida-re:schema:conformance:v1",
  "title": "ruida-re conformance vectors v1",
  "description": "Executable vectors for Ruida codec implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog",
    "sources",
    "field_vectors",
    "swizzle_vectors",
    "job_checksum_vectors",
    "udp_vectors"
  ],
  "properties": {
    "schema": {
      "const": "ruida-re.conformance.v1"
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "field_vectors": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fieldVector"
      }
    },
    "swizzle_vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/swizzleVector"
      }
    },
    "job_checksum_vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/jobChecksumVector"
      }
    },
    "udp_vectors": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/udpVector"
      }
    }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "ruida-re.catalog.v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "url",
        "revision",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "comparison-oracle",
            "local-fixture",
            "permissive-reference"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "enum": [
            null,
            "GPL-2.0-only",
            "LGPL-3.0-or-later",
            "MIT"
          ]
        },
        "local_path": {
          "type": "string",
          "pattern": "^fixtures/[a-zA-Z0-9._/-]+$"
        }
      }
    },
    "fieldVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "codec",
        "parameters",
        "encode_json_value",
        "wire_hex",
        "decode_json_value",
        "canonical",
        "assertions",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/vectorId"
        },
        "codec": {
          "$ref": "#/$defs/codecId"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "encode_json_value": {
          "$ref": "#/$defs/jsonScalar"
        },
        "wire_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "decode_json_value": {
          "$ref": "#/$defs/jsonScalar"
        },
        "canonical": {
          "const": true
        },
        "assertions": {
          "const": [
            "encode",
            "decode"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "oneOf": [
        {
          "properties": {
            "codec": {
              "const": "bytes-7bit"
            },
            "parameters": {
              "required": [
                "size"
              ],
              "maxProperties": 1
            }
          }
        },
        {
          "properties": {
            "codec": {
              "enum": [
                "scaled-s32",
                "scaled-u35"
              ]
            },
            "parameters": {
              "required": [
                "scale"
              ],
              "maxProperties": 1
            }
          }
        },
        {
          "properties": {
            "codec": {
              "enum": [
                "absolute-mm-s32",
                "color-bgr-u35",
                "cstring-7bit",
                "packed-bytes8-u35",
                "power-u14",
                "relative-mm-s14",
                "s7",
                "s35",
                "u7",
                "u14",
                "u35"
              ]
            },
            "parameters": {
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "codecId": {
      "enum": [
        "absolute-mm-s32",
        "bytes-7bit",
        "color-bgr-u35",
        "cstring-7bit",
        "packed-bytes8-u35",
        "power-u14",
        "relative-mm-s14",
        "s7",
        "s35",
        "scaled-s32",
        "scaled-u35",
        "u7",
        "u14",
        "u35"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "jsonScalar": {
      "type": [
        "number",
        "string"
      ],
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "swizzleVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "magic",
        "logical_hex",
        "scrambled_hex",
        "assertions",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/vectorId"
        },
        "magic": {
          "$ref": "#/$defs/byte"
        },
        "logical_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "scrambled_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "assertions": {
          "const": [
            "swizzle",
            "unswizzle"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "jobChecksumVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "algorithm",
        "logical_without_checksum_hex",
        "logical_without_checksum_sha256",
        "checksum_integer",
        "encoded_checksum_command_hex",
        "assertions",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/vectorId"
        },
        "algorithm": {
          "const": "sum-logical-bytes-without-e505-frame"
        },
        "logical_without_checksum_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "logical_without_checksum_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checksum_integer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34359738367
        },
        "encoded_checksum_command_hex": {
          "type": "string",
          "pattern": "^e505(?:[0-7][0-9a-f]){5}$"
        },
        "assertions": {
          "const": [
            "calculate-checksum",
            "encode-command"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "udpVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "context",
        "direction",
        "framing",
        "magic",
        "logical_hex",
        "scrambled_hex",
        "checksum_hex",
        "datagram_hex",
        "assertions",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/vectorId"
        },
        "context": {
          "enum": [
            "job",
            "reply",
            "request"
          ]
        },
        "direction": {
          "enum": [
            "controller-to-host",
            "host-to-controller"
          ]
        },
        "framing": {
          "enum": [
            "big-endian-u16-checksum-prefix",
            "checksumless-scrambled-payload"
          ]
        },
        "magic": {
          "$ref": "#/$defs/byte"
        },
        "logical_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "scrambled_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "checksum_hex": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{4}$"
        },
        "datagram_hex": {
          "$ref": "#/$defs/nonemptyHex"
        },
        "assertions": {
          "const": [
            "encode-datagram",
            "decode-datagram"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "context": {
                "enum": [
                  "job",
                  "request"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "direction": {
                "const": "host-to-controller"
              },
              "framing": {
                "const": "big-endian-u16-checksum-prefix"
              },
              "checksum_hex": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "context": {
                "const": "reply"
              }
            }
          },
          "then": {
            "properties": {
              "direction": {
                "const": "controller-to-host"
              },
              "framing": {
                "const": "checksumless-scrambled-payload"
              },
              "checksum_hex": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "source_ids"
      ],
      "properties": {
        "classification": {
          "enum": [
            "codec-contract",
            "controlled-fixture",
            "pinned-reference",
            "pinned-reference-agreement"
          ]
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^fixtures/[a-zA-Z0-9._/-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "vectorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "nonemptyHex": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
