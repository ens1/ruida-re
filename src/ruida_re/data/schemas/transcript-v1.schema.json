{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruida-re:schema:transcript:v1",
  "title": "ruida-re transcript v1",
  "description": "Ordered, lossless Ruida UDP datagram transcript.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "datagrams"
  ],
  "properties": {
    "schema": {
      "const": "ruida-re.transcript.v1"
    },
    "datagrams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/datagram"
      }
    }
  },
  "$defs": {
    "hexBytes": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "port"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "udpProgram": {
      "allOf": [
        {
          "$ref": "#/$defs/program"
        },
        {
          "properties": {
            "container": {
              "const": "udp"
            },
            "header": {
              "const": ""
            }
          }
        }
      ]
    },
    "datagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "context",
        "raw",
        "program",
        "issues"
      ],
      "properties": {
        "direction": {
          "enum": [
            "outbound",
            "inbound"
          ]
        },
        "context": {
          "enum": [
            "job",
            "request",
            "reply"
          ]
        },
        "timestamp": {
          "description": "Bounded JSON number canonicalized to IEEE-754 binary64.",
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "destination": {
          "$ref": "#/$defs/endpoint"
        },
        "raw": {
          "$ref": "#/$defs/hexBytes"
        },
        "program": {
          "oneOf": [
            {
              "$ref": "#/$defs/udpProgram"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "outbound"
              }
            },
            "required": [
              "direction"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "enum": [
                  "job",
                  "request"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "direction": {
                "const": "inbound"
              }
            },
            "required": [
              "direction"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "const": "reply"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "program": {
                "type": "null"
              }
            },
            "required": [
              "program"
            ]
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "context": {
                "const": "job"
              },
              "program": {
                "type": "object"
              }
            },
            "required": [
              "context",
              "program"
            ]
          },
          "then": {
            "properties": {
              "program": {
                "properties": {
                  "context": {
                    "const": "job"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "context": {
                "const": "request"
              },
              "program": {
                "type": "object"
              }
            },
            "required": [
              "context",
              "program"
            ]
          },
          "then": {
            "properties": {
              "program": {
                "properties": {
                  "context": {
                    "const": "request"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "context": {
                "const": "reply"
              },
              "program": {
                "type": "object"
              }
            },
            "required": [
              "context",
              "program"
            ]
          },
          "then": {
            "properties": {
              "program": {
                "properties": {
                  "context": {
                    "const": "reply"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "program": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:ruida-re:schema:program:v1",
      "title": "ruida-re structural program envelope v1",
      "description": "Structural schema for a lossless decoded Ruida program. Command identity, field domains, and raw-byte consistency are validated with catalog-v1.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "magic",
        "context",
        "container",
        "header",
        "records",
        "issues",
        "source_checksum_basis"
      ],
      "properties": {
        "schema": {
          "const": "ruida-re.program.v1"
        },
        "magic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "context": {
          "enum": [
            "job",
            "request",
            "reply"
          ]
        },
        "container": {
          "enum": [
            "rd",
            "udp",
            "logical"
          ]
        },
        "header": {
          "type": "string",
          "pattern": "^(?:|5244574f524b56[0-9a-f]{6})$"
        },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/commandRecord"
              },
              {
                "$ref": "#/$defs/rawRecord"
              }
            ]
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_checksum_basis": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "container": {
                "enum": [
                  "udp",
                  "logical"
                ]
              }
            },
            "required": [
              "container"
            ]
          },
          "then": {
            "properties": {
              "header": {
                "const": ""
              }
            }
          }
        }
      ],
      "$defs": {
        "hexBytes": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "opcode": {
          "type": "string",
          "pattern": "^(?:[89a-f][0-9a-f])(?:[0-7][0-9a-f])*$"
        },
        "commandRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "offset",
            "opcode",
            "name",
            "values",
            "shape_evidence",
            "semantic_evidence"
          ],
          "properties": {
            "kind": {
              "const": "command"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "opcode": {
              "$ref": "#/$defs/opcode"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "values": {
              "description": "Catalog integer fields require an exact mathematical integer; catalog number fields canonicalize bounded input to IEEE-754 binary64.",
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ],
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "raw": {
              "$ref": "#/$defs/hexBytes"
            },
            "shape_evidence": {
              "$ref": "#/$defs/shapeEvidence"
            },
            "semantic_evidence": {
              "$ref": "#/$defs/semanticEvidence"
            }
          }
        },
        "rawRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "offset",
            "raw"
          ],
          "properties": {
            "kind": {
              "const": "raw"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "raw": {
              "$ref": "#/$defs/hexBytes"
            }
          }
        },
        "shapeEvidence": {
          "enum": [
            "conflicting-reports",
            "external-fixture-observed",
            "fixture-observed",
            "reported",
            "simulator-only",
            "uncited-hypothesis"
          ]
        },
        "semanticEvidence": {
          "enum": [
            "controlled-fixture",
            "disputed",
            "partially-controlled",
            "reported",
            "uncited-hypothesis",
            "unverified"
          ]
        }
      }
    }
  }
}
